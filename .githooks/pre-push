#!/bin/sh
set -e

# Read pushed refs from stdin
is_gh_pages_push=0
is_main_push=0

while read local_ref local_oid remote_ref remote_oid; do
  case "$remote_ref" in
    *gh-pages*) is_gh_pages_push=1 ;;
    *main*) is_main_push=1 ;;
  esac
done

# If already pushing to gh-pages branch, exit immediately to prevent recursion
if [ "$is_gh_pages_push" -eq 1 ]; then
  exit 0
fi

# When pushing main branch, run gh-deploy to publish to GitHub Pages
if [ "$is_main_push" -eq 1 ]; then
  echo "🚀 [hook] Triggering gh-deploy for blog.neurohubcare.com..."
  npm run gh-deploy
  echo "✅ [hook] Static website deployed to gh-pages."
fi

exit 0
